{
  "rules": {
    "stories": {
      ".read": true,
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('creatorUid').val() === auth.uid || root.child('config/admins').child(auth.uid).val() === true)",
        "playCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber()"
        },
        "likeCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      }
    },
    "posts": {
      ".read": true,
      ".indexOn": [
        "createdAt",
        "creatorUid"
      ],
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('creatorUid').val() === auth.uid || root.child('config/admins').child(auth.uid).val() === true)",
        "likeCount": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "featured": {
          ".write": "auth != null && root.child('config/admins').child(auth.uid).val() === true"
        }
      }
    },
    "users": {
      "$uid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "brain": {
      "lessons": {
        ".read": true,
        ".write": "auth != null && root.child('config/admins').child(auth.uid).val() === true"
      },
      "sources": {
        ".read": "auth != null && root.child('config/admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('config/admins').child(auth.uid).val() === true"
      },
      "pages": {
        ".read": "auth != null && root.child('config/admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('config/admins').child(auth.uid).val() === true"
      },
      "meta": {
        ".read": true,
        ".write": "auth != null && root.child('config/admins').child(auth.uid).val() === true"
      }
    },
    "reports": {
      ".read": false,
      ".write": "auth != null"
    },
    "config": {
      ".read": true,
      ".write": false
    },
    "usernames": {
      ".read": true,
      "$name": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid) && (newData.val() === auth.uid || newData.val() === null)",
        ".validate": "newData.isString() && $name.matches(/^[a-z0-9_.]{3,20}$/)"
      }
    },
    "private": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}