{
  "rules": {
    "stories": {
      ".read": true,
      "$id": {
        ".write": "auth != null && (!data.exists() || data.child('creatorUid').val() === auth.uid)",
        "playCount": { ".write": "auth != null", ".validate": "newData.isNumber()" },
        "likeCount": { ".write": "auth != null", ".validate": "newData.isNumber() && newData.val() >= 0" }
      }
    },
    "posts": {
      ".read": true,
      "$id": { ".write": "auth != null && (!data.exists() || data.child('creatorUid').val() === auth.uid)" }
    },
    "users": {
      "$uid": { ".read": true, ".write": "auth != null && auth.uid === $uid" }
    },
    "reports": { ".read": false, ".write": "auth != null" },
    "config": { ".read": true, ".write": false }
  }
}
